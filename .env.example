# Copy to `.env` (never commit .env). Docker Compose reads it automatically.
# --- Image versions (pinned; change only if you know why) ---
OPENSEARCH_VERSION=2.19.7
DATA_PREPPER_VERSION=2.12.0
COLLECTOR_VERSION=0.165.0

# --- Collector tuning (optional; defaults in collector/*.yaml) ---
# COLLECTOR_CONFIG=otel-collector-config.yaml      # or otel-collector-nosampling.yaml (sampling OFF)
# BATCH_SIZE=512
# BATCH_TIMEOUT=5s
# TAIL_DECISION_WAIT=10s
# ORDINARY_SAMPLING_PCT=10
# SLOW_THRESHOLD_MS=500

# --- Web UI + API port binding. 127.0.0.1 = only this computer. On the EC2 server set 0.0.0.0 ---
# BACKEND_BIND=127.0.0.1
# CORS_ORIGINS=http://localhost:5173

# --- Amazon S3 archive (docs/AWS_SETUP.md). NO access keys here: use your AWS profile (local) or an IAM role (EC2) ---
S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
# S3_PREFIX=telemetry/
# S3_STORAGE_CLASS=STANDARD_IA
AWS_PROFILE=default

# --- Amazon CloudWatch custom metrics ---
CLOUDWATCH_ENABLED=true
# CLOUDWATCH_NAMESPACE=TraceFlow/Telemetry
# CLOUDWATCH_INTERVAL_SEC=60
# CLOUDWATCH_ERROR_ALARM_PCT=20
# DEPLOY_ENV=local          # use "production" on EC2 so local and server metrics stay separate
